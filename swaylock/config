# The config file is for swaylock-effects instead of swaylock.

screenshots
effect-blur=7x5
effect-vignette=0.5:0.5

clock
timestr=%H:%M
datestr=%A, %B %d

indicator
indicator-radius=110
indicator-thickness=7
indicator-idle-visible

daemonize
ignore-empty-password
show-failed-attempts
grace=2
fade-in=0.2

ring-color=89b4fa
key-hl-color=a6e3a1
line-color=00000000
inside-color=1e1e2e88
separator-color=00000000
text-color=cdd6f4
